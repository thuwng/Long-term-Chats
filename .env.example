# Backbone LLM (openai/gpt-oss-20b), served locally via vLLM/Ollama/etc.
# with an OpenAI-compatible /v1/chat/completions endpoint.
MEMORAI_LLM_MODEL=openai/gpt-oss-20b
MEMORAI_LLM_API_BASE=http://localhost:8000/v1
MEMORAI_LLM_API_KEY=EMPTY

# Embedding model (Contriever by default, matching the paper's fair-comparison setup)
MEMORAI_EMBED_MODEL=facebook/contriever
MEMORAI_EMBED_DEVICE=cpu

# GPT-4o judge (Appendix C.7) - real OpenAI API key required only if --run_judge is used
OPENAI_API_KEY=
MEMORAI_JUDGE_MODEL=gpt-4o
